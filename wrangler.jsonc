{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahmooddada",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6b794bc5-494d-4c0b-9930-e7a3dfb7250a","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d15445f0cce84342a199789989e4f1e3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
